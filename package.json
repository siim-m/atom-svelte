{
  "name": "@siim-m/atom-svelte",
  "version": "0.0.1-alpha.3",
  "description": "Svelte 5 bindings for Effect's Atom reactivity modules.",
  "keywords": [
    "atom",
    "effect",
    "effect-ts",
    "state-management",
    "svelte",
    "svelte5"
  ],
  "homepage": "https://github.com/siim-m/atom-svelte#readme",
  "bugs": {
    "url": "https://github.com/siim-m/atom-svelte/issues"
  },
  "license": "MIT",
  "author": "siim-m",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siim-m/atom-svelte.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "alpha"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist && bun run scripts/RewriteDeclarationImports.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "bun run test:browser && bun run test:ssr && bun run test:async-disabled",
    "test:browser": "vitest run",
    "test:ssr": "vitest run --config vitest.ssr.config.ts",
    "test:async-disabled": "vitest run --config vitest.async-disabled.config.ts",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware",
    "format:check": "oxfmt --check && bun run format:svelte:check",
    "format:fix": "oxfmt && bun run format:svelte:fix",
    "format:svelte:check": "prettier --config prettier.svelte.config.cjs --check \"**/*.svelte\"",
    "format:svelte:fix": "prettier --config prettier.svelte.config.cjs --write \"**/*.svelte\"",
    "check:package": "bun run build && publint --pack npm --strict",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run check:package",
    "prepack": "bun run build"
  },
  "dependencies": {
    "esm-env": "^1.2.2"
  },
  "devDependencies": {
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "24.13.3",
    "effect": "4.0.2",
    "jsdom": "30.0.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "publint": "0.3.23",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "svelte": "^5.56.8"
  },
  "packageManager": "bun@1.3.14"
}
